# Release signing for AGAPE. Copy this file to keystore.properties (which git ignores) and fill it in.
# Never commit keystore.properties or the .jks file. Keep a safe backup of both: with Play App Signing this is the
# upload key, which Google can reset if it is lost, but only after a request.
#
# Instead of this file the same values can come from environment variables (for example in CI):
#   AGAPE_KEYSTORE_FILE, AGAPE_KEYSTORE_PASSWORD, AGAPE_KEY_ALIAS, AGAPE_KEY_PASSWORD
#
# Path to the keystore, relative to the repository root (or absolute).
storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
