<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and later: what goes into the Google backup and a device-to-device transfer.
    Kept: settings, the notes, highlights and favourites (agape_user.db), prayer progress.
    Left out: the sign-in session (the user signs in again on a new phone), the development account, and the alarm
    bookkeeping of this device. The Bible database copy lives in noBackupFilesDir and is never backed up.
    The session file is named after the package (applicationId + "_preferences.xml"): update it here and in
    backup_rules.xml when the package name changes (BackupRulesTest checks this).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="agape.app_preferences.xml" />
        <exclude domain="sharedpref" path="agape_dev_auth.xml" />
        <exclude domain="sharedpref" path="agape_alarms.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="agape.app_preferences.xml" />
        <exclude domain="sharedpref" path="agape_dev_auth.xml" />
        <exclude domain="sharedpref" path="agape_alarms.xml" />
    </device-transfer>
</data-extraction-rules>
